# ─── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database (MySQL) ────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=elite_images_db

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── Initial Admin Seed (created on first boot) ──────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=System Administrator
ADMIN_ROLE=super_admin

# ─── CORS ────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Email / SMTP (password reset codes) ─────────────────────
# Leave empty to run without a mail server (dev code is returned in the API response)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# ─── Uploads ─────────────────────────────────────────────────
MAX_IMAGE_MB=15

# ─── Image Storage (Cloudinary — production) ─────────────────
# Fill all three to store images in Cloudinary. Leave empty to use
# local disk storage (development only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Cookie Security (optional override) ─────────────────────
# By default cookies are secure+sameSite:none only when CLIENT_URL is https.
# Force with true/false if behind an unusual proxy setup.
COOKIE_SECURE=
